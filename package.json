{
  "name": "slot-math-engine",
  "version": "1.0.0",
  "description": "Math engine for a 5x3, 20-line video slot with configurable RTP, Wild, Scatter, and Free Spins.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"{src,tests,scripts}/**/*.ts\"",
    "test": "jest",
    "test:ci": "jest --ci --runInBand",
    "simulate": "ts-node scripts/simulate.ts",
    "balance": "ts-node scripts/balance.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
